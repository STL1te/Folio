# Host tools and headers must come from the developer's own PS5 SDK installation.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
file(TO_CMAKE_PATH "$ENV{SCE_PROSPERO_SDK_DIR}" FOLIO_PS5_SDK)
if(CMAKE_HOST_WIN32)
	set(FOLIO_HOST_EXE ".exe")
endif()
set(CMAKE_C_COMPILER "${FOLIO_PS5_SDK}/host_tools/bin/prospero-clang${FOLIO_HOST_EXE}")
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
if(NOT EXISTS "${CMAKE_C_COMPILER}")
	message(FATAL_ERROR "Set SCE_PROSPERO_SDK_DIR to the PS5 SDK root before configuring Folio")
endif()
set(CMAKE_AR "${FOLIO_PS5_SDK}/host_tools/bin/prospero-llvm-ar${FOLIO_HOST_EXE}")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_AR> s <TARGET>")
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_AR> s <TARGET>")
set(CMAKE_C_FLAGS_INIT "-fPIC -march=znver2 -isystem \"${FOLIO_PS5_SDK}/target/include\"")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
